# ZEKS — environment variables
#
# Copy this file to `.env.local` and fill in real values. `.env*` is
# git-ignored so secrets are never committed.
#
# -----------------------------------------------------------------------------
# Phase 4B — Persistent price-history storage (Postgres + Neon)
# -----------------------------------------------------------------------------
#
# `DATABASE_URL` is required ONLY when actually reading or writing
# price-history samples. The chart empty-state copy does NOT need it.
#
# Format: `postgres://user:password@host/dbname?sslmode=require`
# (Neon provides this string in the project dashboard.)
#
# To create a Neon project:
#
#   1. Sign in at https://console.neon.tech
#   2. Create a new project (free tier is sufficient for dev).
#   3. Open the project's "Connection Details" panel.
#   4. Copy the pooled connection string (it includes `?sslmode=require`
#      and is safe to use from serverless functions / Edge).
#   5. Paste it below as the value of DATABASE_URL.
#
# Do NOT commit the real connection string. Do NOT add it to `.env`.
# Use `.env.local` (git-ignored) for local development.
#
# Example (PLACEHOLDER ONLY — replace with your real Neon URL):
#
#   DATABASE_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/zeks?sslmode=require
#
# When `DATABASE_URL` is not configured, the storage layer throws a
# descriptive error on first use. Build / type-check / lint do NOT
# require it.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Phase 4B / Phase C2 — Scheduled real-price history collector
# -----------------------------------------------------------------------------
#
# `CRON_SECRET` is the bearer token Vercel Cron sends on every invocation
# of /api/cron/history-collect (per the schedule in vercel.json).
#
# To enable scheduled collection in production:
#
#   1. Generate a random secret (e.g. `openssl rand -hex 32`).
#   2. Set it as a Vercel environment variable named `CRON_SECRET`.
#   3. Vercel automatically attaches it as
#      `Authorization: Bearer <CRON_SECRET>` on each cron call.
#
# Locally, leave `CRON_SECRET` unset and use `npm run history:collect-once`
# instead — the route refuses to run when the secret is missing.
#
# Do NOT commit a real secret value.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Public surface URLs
# -----------------------------------------------------------------------------
#
# `NEXT_PUBLIC_DOCS_URL` is where the sidebar's "Docs" entry points.
# The docs site is meant to live on its own domain, separate from
# the app, so it can be published and indexed independently.
#
# Examples:
#   Production : https://docs.zeks.fund
#   Preview    : leave unset — falls back to the same-origin /docs
#
# Unset is safe. With no value the sidebar links to "/docs", which
# exists in this app, so local dev and PR previews never produce a
# dead link. This variable is public by design: it is compiled into
# the client bundle. Never put a secret here.
NEXT_PUBLIC_DOCS_URL=

